# Database (Neon, Supabase, or Render Postgres all work — copy the connection string they give you)
DATABASE_URL="postgresql://user:password@host:5432/createlume?sslmode=require"

# Stripe (from your Stripe Dashboard > Developers > API keys)
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Create one Product with 3 Prices in Stripe (Foundation $499/mo, Growth $1499/mo,
# Managed $2499/mo), then paste each Price ID here.
STRIPE_PRICE_FOUNDATION="price_..."
STRIPE_PRICE_GROWTH="price_..."
STRIPE_PRICE_MANAGED="price_..."

NEXT_PUBLIC_SITE_URL="https://createlume.com"
